{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyx-ai-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "7312049",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
